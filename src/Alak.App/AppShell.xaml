<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
        xmlns:views="clr-namespace:Alak.App.Views"
        xmlns:services="clr-namespace:Alak.App.Services"
        x:Class="Alak.App.AppShell"
        Shell.FlyoutBehavior="Disabled"
        Shell.NavBarIsVisible="False"
        Shell.NavBarHasShadow="False"
        FlowDirection="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=CurrentFlowDirection}"
        Shell.BackgroundColor="{AppThemeBinding Light={StaticResource Salt}, Dark={StaticResource Night}}"
        Shell.ForegroundColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Txt}}"
        Shell.TitleColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Txt}}"
        Shell.TabBarBackgroundColor="{AppThemeBinding Light={StaticResource Paper}, Dark={StaticResource SurfaceDark}}"
        Shell.TabBarForegroundColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Txt}}"
        Shell.TabBarTitleColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Txt}}"
        Shell.TabBarUnselectedColor="{AppThemeBinding Light={StaticResource Ink3}, Dark={StaticResource Txt3}}">

    <!--
        Bottom tabs (SPEC §13). Exactly one TabBar, nothing else at the root level:
        stray top-level ShellContent items here previously broke the tab bar down to
        a single visible tab. Modal pages (detail, onboarding, stub-detail) are
        registered via Routing.RegisterRoute in code-behind instead.
    -->
    <TabBar>
        <Tab Title="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Tab_Inbox]}" Icon="inbox.svg" Route="inbox">
            <ShellContent ContentTemplate="{DataTemplate views:InboxPage}" />
        </Tab>

        <Tab Title="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Tab_Codes]}" Icon="wallet.svg" Route="wallet">
            <ShellContent ContentTemplate="{DataTemplate views:WalletPage}" />
        </Tab>

        <Tab Title="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Tab_Digest]}" Icon="digest.svg" Route="digest">
            <ShellContent ContentTemplate="{DataTemplate views:DigestPage}" />
        </Tab>

        <Tab Title="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Tab_Settings]}" Icon="settings.svg" Route="settings">
            <ShellContent ContentTemplate="{DataTemplate views:SettingsPage}" />
        </Tab>
    </TabBar>

</Shell>
