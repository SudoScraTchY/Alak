<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:design="clr-namespace:Alak.App.Design"
                    xmlns:sys="clr-namespace:System;assembly=netstandard">

    <!-- ===== FONT FAMILIES (registered in MauiProgram) ===== -->
    <x:String x:Key="Font.Primary">Vazirmatn</x:String>
    <x:String x:Key="Font.Mono">JetBrainsMono</x:String>

    <!-- ===== FONT WEIGHTS ===== -->
    <sys:Double x:Key="FontWeight.Regular">400</sys:Double>
    <sys:Double x:Key="FontWeight.Medium">500</sys:Double>
    <sys:Double x:Key="FontWeight.SemiBold">600</sys:Double>

    <!-- ===== TYPOGRAPHY STYLES (spec §12.3) ===== -->
    <!-- Display (empty states, onboarding headline): 28/36, Medium -->
    <Style x:Key="Text.Display" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="LineHeight" Value="36" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource PrimaryText}" />
        <Setter Property="MaxLines" Value="1" />
    </Style>

    <!-- Title (screen header, section header): 20/28, Medium -->
    <Style x:Key="Text.Title" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="LineHeight" Value="28" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource PrimaryText}" />
    </Style>

    <!-- Body: 16/24 (Latin), 16/26 (Persian - handled via FlowDirection in View) -->
    <Style x:Key="Text.Body" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineHeight" Value="24" />
        <Setter Property="TextColor" Value="{StaticResource PrimaryText}" />
    </Style>

    <Style x:Key="Text.BodyPersian" TargetType="Label" BasedOn="{StaticResource Text.Body}">
        <Setter Property="LineHeight" Value="26" />
    </Style>

    <!-- Body secondary: 14/22 -->
    <Style x:Key="Text.BodySecondary" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="22" />
        <Setter Property="TextColor" Value="{StaticResource SecondaryText}" />
    </Style>

    <!-- Label (button, tab, chip): 14/20, SemiBold, Sentence case -->
    <Style x:Key="Text.Label" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource PrimaryText}" />
    </Style>

    <!-- Code / mono: 18/24, letter-spacing +0.5px, Medium -->
    <Style x:Key="Text.Code" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="LineHeight" Value="24" />
        <Setter Property="TextColor" Value="{StaticResource PrimaryText}" />
        <Setter Property="CharacterSpacing" Value="0.5" />
    </Style>

    <!-- Caption: 12/18 -->
    <Style x:Key="Text.Caption" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="TextColor" Value="{StaticResource TertiaryText}" />
    </Style>

    <!-- ===== BUTTON STYLES ===== -->
    <Style x:Key="Button.Primary" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource PrimaryButtonText}" />
        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryButtonBackground}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.MD}" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="Padding" Value="24,0" />
    </Style>

    <Style x:Key="Button.Secondary" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource PrimaryText}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderColor" Value="{StaticResource Divider}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.MD}" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="Padding" Value="24,0" />
    </Style>

    <Style x:Key="Button.TextOnly" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource Mark.Promo}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <!-- ===== ENTRY STYLES ===== -->
    <Style x:Key="Entry.Standard" TargetType="Entry">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{StaticResource PrimaryText}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TertiaryText}" />
        <Setter Property="BackgroundColor" Value="{StaticResource CardBackground}" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

</ResourceDictionary>