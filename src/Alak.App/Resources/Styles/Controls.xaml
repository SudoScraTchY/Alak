<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:design="clr-namespace:Alak.App.Design"
                    xmlns:sys="clr-namespace:System;assembly=netstandard">

    <!-- ===== LIST ITEM (Inbox row) ===== -->
    <Style x:Key="Frame.ListItem" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource CardBackground}" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="HasShadow" Value="False" />
        <Setter Property="Padding" Value="{StaticResource Spacing.MD}" />
        <Setter Property="BorderColor" Value="{StaticResource Divider}" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <!-- Category spine (left edge accent) -->
    <Style x:Key="BoxView.CategorySpine" TargetType="BoxView">
        <Setter Property="WidthRequest" Value="4" />
        <Setter Property="Color" Value="{StaticResource Mark.Promo}" />
        <Setter Property="VerticalOptions" Value="Fill" />
    </Style>

    <!-- ===== STUB CONTENT LAYOUT ===== -->
    <Style x:Key="Grid.StubContent" TargetType="Grid">
        <Setter Property="RowDefinitions">
            <Setter.Value>
                <RowDefinitionCollection>
                    <RowDefinition Height="Auto" /> <!-- Code -->
                    <RowDefinition Height="Auto" /> <!-- Discount/amount -->
                    <RowDefinition Height="Auto" /> <!-- Expiry/merchant -->
                </RowDefinitionCollection>
            </Setter.Value>
        </Setter>
        <Setter Property="ColumnDefinitions">
            <Setter.Value>
                <ColumnDefinitionCollection>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" /> <!-- Copy button -->
                </ColumnDefinitionCollection>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== COLLECTION VIEW (Inbox list) ===== -->
    <Style x:Key="CollectionView.Inbox" TargetType="CollectionView">
        <Setter Property="SelectionMode" Value="None" />
        <Setter Property="ItemsLayout">
            <Setter.Value>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="BackgroundColor" Value="{StaticResource PageBackground}" />
    </Style>

    <!-- ===== SEARCH BAR ===== -->
    <Style x:Key="SearchBar.Standard" TargetType="SearchBar">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{StaticResource PrimaryText}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TertiaryText}" />
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceBackground}" />
        <Setter Property="CancelButtonColor" Value="{StaticResource PrimaryText}" />
        <Setter Property="Margin" Value="{StaticResource Spacing.MD}" />
        <Setter Property="HeightRequest" Value="56" />
    </Style>

    <!-- ===== ACTIVITY INDICATOR ===== -->
    <Style x:Key="ActivityIndicator.Standard" TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource Mark.Promo}" />
        <Setter Property="WidthRequest" Value="24" />
        <Setter Property="HeightRequest" Value="24" />
    </Style>

    <!-- ===== REFRESH VIEW ===== -->
    <Style x:Key="RefreshView.Standard" TargetType="RefreshView">
        <Setter Property="RefreshColor" Value="{StaticResource Mark.Promo}" />
    </Style>

    <!-- ===== SWITCH (Settings toggles) ===== -->
    <Style x:Key="Switch.Standard" TargetType="Switch">
        <Setter Property="OnColor" Value="{StaticResource Mark.Promo}" />
        <Setter Property="ThumbColor" Value="White" />
        <Setter Property="HorizontalOptions" Value="End" />
    </Style>

    <!-- ===== PICKER (Language/Calendar selectors) ===== -->
    <Style x:Key="Picker.Standard" TargetType="Picker">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{StaticResource PrimaryText}" />
        <Setter Property="BackgroundColor" Value="{StaticResource CardBackground}" />
        <Setter Property="TitleColor" Value="{StaticResource TertiaryText}" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

</ResourceDictionary>