<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ===== CATEGORY CHIP (tint background + mark text — the AA-safe pairing) ===== -->
    <Style x:Key="Chip.Category" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="999" />
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Filter pill (Inbox category tabs) -->
    <Style x:Key="Chip.Filter" TargetType="Border" BasedOn="{StaticResource Chip.Category}">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Stroke">
            <Setter.Value>
                <AppThemeBinding Light="{StaticResource Hairline}" Dark="{StaticResource HairlineD}" />
            </Setter.Value>
        </Setter>
        <Setter Property="StrokeThickness" Value="1" />
    </Style>

    <!-- Category spine (left edge mark on a row) -->
    <Style x:Key="BoxView.CategorySpine" TargetType="BoxView">
        <Setter Property="WidthRequest" Value="3" />
        <Setter Property="VerticalOptions" Value="Fill" />
        <Setter Property="HorizontalOptions" Value="Start" />
    </Style>

    <!-- ===== LIST ===== -->
    <Style x:Key="CollectionView.Inbox" TargetType="CollectionView">
        <Setter Property="SelectionMode" Value="None" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style x:Key="RefreshView.Standard" TargetType="RefreshView">
        <Setter Property="RefreshColor">
            <Setter.Value>
                <AppThemeBinding Light="{StaticResource Mark.Work}" Dark="{StaticResource Mark.Work.Dark}" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ActivityIndicator.Standard" TargetType="ActivityIndicator">
        <Setter Property="Color">
            <Setter.Value>
                <AppThemeBinding Light="{StaticResource Mark.Work}" Dark="{StaticResource Mark.Work.Dark}" />
            </Setter.Value>
        </Setter>
        <Setter Property="WidthRequest" Value="24" />
        <Setter Property="HeightRequest" Value="24" />
    </Style>

    <!-- ===== LEGACY FRAME CHIP (until pages migrate to Border) ===== -->
    <Style x:Key="Frame.Chip" TargetType="Frame">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="HasShadow" Value="False" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="BorderColor" Value="Transparent" />
        <Setter Property="HorizontalOptions" Value="Start" />
    </Style>

</ResourceDictionary>
