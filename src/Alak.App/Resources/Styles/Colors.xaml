<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:design="clr-namespace:Alak.App.Design">

    <!-- ===== LIGHT THEME ===== -->
    <Color x:Key="Light.Salt">#F3F5F6</Color>
    <Color x:Key="Light.Paper">#FFFFFF</Color>
    <Color x:Key="Light.Ink">#12252B</Color>
    <Color x:Key="Light.Ink2">#4A5D64</Color>
    <Color x:Key="Light.Ink3">#5B6B72</Color>
    <Color x:Key="Light.Hairline">#DCE2E5</Color>
    <Color x:Key="Light.AccentInk">#12252B</Color>
    <Color x:Key="Light.Error">#B3261E</Color>

    <!-- Category tints (light) - ink-on-tint ≥ 7.4:1 -->
    <Color x:Key="Light.PromoTint">#E8F4FD</Color>
    <Color x:Key="Light.WorkTint">#E8F5E9</Color>
    <Color x:Key="Light.PeopleTint">#FFF3E0</Color>
    <Color x:Key="Light.MoneyTint">#E0F2F1</Color>
    <Color x:Key="Light.OrdersTint">#F3E5F5</Color>
    <Color x:Key="Light.SecurityTint">#FFEBEE</Color>
    <Color x:Key="Light.SocialTint">#E8EAF6</Color>
    <Color x:Key="Light.UpdatesTint">#ECEFF1</Color>
    <Color x:Key="Light.OtherTint">#F5F5F5</Color>

    <!-- ===== DARK THEME ===== -->
    <Color x:Key="Dark.Night">#0C1417</Color>
    <Color x:Key="Dark.Surface">#131E22</Color>
    <Color x:Key="Dark.Raised">#1B2A2F</Color>
    <Color x:Key="Dark.Txt">#E7EEF0</Color>
    <Color x:Key="Dark.Txt2">#A3B5BB</Color>
    <Color x:Key="Dark.Txt3">#81959B</Color>
    <Color x:Key="Dark.Hairline">#243339</Color>
    <Color x:Key="Dark.Error">#FF8A80</Color>

    <!-- Category tints (dark) -->
    <Color x:Key="Dark.PromoTint">#152A3A</Color>
    <Color x:Key="Dark.WorkTint">#152A20</Color>
    <Color x:Key="Dark.PeopleTint">#332815</Color>
    <Color x:Key="Dark.MoneyTint">#152A27</Color>
    <Color x:Key="Dark.OrdersTint">#2A152A</Color>
    <Color x:Key="Dark.SecurityTint">#3A1518</Color>
    <Color x:Key="Dark.SocialTint">#1A1A2E</Color>
    <Color x:Key="Dark.UpdatesTint">#1A2228</Color>
    <Color x:Key="Dark.OtherTint">#242424</Color>

    <!-- ===== CATEGORY MARK COLORS ===== -->
    <Color x:Key="Mark.Promo">#1E88E5</Color>
    <Color x:Key="Mark.Work">#2E7D32</Color>
    <Color x:Key="Mark.People">#EF6C00</Color>
    <Color x:Key="Mark.Money">#00897B</Color>
    <Color x:Key="Mark.Orders">#7B1FA2</Color>
    <Color x:Key="Mark.Security">#C62828</Color>
    <Color x:Key="Mark.Social">#3949AB</Color>
    <Color x:Key="Mark.Updates">#546E7A</Color>
    <Color x:Key="Mark.Other">#616161</Color>

    <!-- ===== SEMANTIC TOKENS (theme-aware via AppThemeBinding) ===== -->
    <Color x:Key="PageBackground">
        <Color.AppThemeBinding Light="{StaticResource Light.Salt}" Dark="{StaticResource Dark.Night}" />
    </Color>
    <Color x:Key="CardBackground">
        <Color.AppThemeBinding Light="{StaticResource Light.Paper}" Dark="{StaticResource Dark.Raised}" />
    </Color>
    <Color x:Key="SurfaceBackground">
        <Color.AppThemeBinding Light="{StaticResource Light.Paper}" Dark="{StaticResource Dark.Surface}" />
    </Color>
    <Color x:Key="PrimaryText">
        <Color.AppThemeBinding Light="{StaticResource Light.Ink}" Dark="{StaticResource Dark.Txt}" />
    </Color>
    <Color x:Key="SecondaryText">
        <Color.AppThemeBinding Light="{StaticResource Light.Ink2}" Dark="{StaticResource Dark.Txt2}" />
    </Color>
    <Color x:Key="TertiaryText">
        <Color.AppThemeBinding Light="{StaticResource Light.Ink3}" Dark="{StaticResource Dark.Txt3}" />
    </Color>
    <Color x:Key="Divider">
        <Color.AppThemeBinding Light="{StaticResource Light.Hairline}" Dark="{StaticResource Dark.Hairline}" />
    </Color>
    <Color x:Key="PrimaryButtonBackground">
        <Color.AppThemeBinding Light="{StaticResource Light.AccentInk}" Dark="{StaticResource Dark.Txt}" />
    </Color>
    <Color x:Key="PrimaryButtonText">
        <Color.AppThemeBinding Light="White" Dark="{StaticResource Dark.Night}" />
    </Color>
    <Color x:Key="ErrorColor">
        <Color.AppThemeBinding Light="{StaticResource Light.Error}" Dark="{StaticResource Dark.Error}" />
    </Color>

    <!-- Category tint (semantic) -->
    <Color x:Key="Category.Promo.Tint">
        <Color.AppThemeBinding Light="{StaticResource Light.PromoTint}" Dark="{StaticResource Dark.PromoTint}" />
    </Color>
    <Color x:Key="Category.Work.Tint">
        <Color.AppThemeBinding Light="{StaticResource Light.WorkTint}" Dark="{StaticResource Dark.WorkTint}" />
    </Color>
    <Color x:Key="Category.People.Tint">
        <Color.AppThemeBinding Light="{StaticResource Light.PeopleTint}" Dark="{StaticResource Dark.PeopleTint}" />
    </Color>
    <Color x:Key="Category.Money.Tint">
        <Color.AppThemeBinding Light="{StaticResource Light.MoneyTint}" Dark="{StaticResource Dark.MoneyTint}" />
    </Color>
    <Color x:Key="Category.Orders.Tint">
        <Color.AppThemeBinding Light="{StaticResource Light.OrdersTint}" Dark="{StaticResource Dark.OrdersTint}" />
    </Color>
    <Color x:Key="Category.Security.Tint">
        <Color.AppThemeBinding Light="{StaticResource Light.SecurityTint}" Dark="{StaticResource Dark.SecurityTint}" />
    </Color>
    <Color x:Key="Category.Social.Tint">
        <Color.AppThemeBinding Light="{StaticResource Light.SocialTint}" Dark="{StaticResource Dark.SocialTint}" />
    </Color>
    <Color x:Key="Category.Updates.Tint">
        <Color.AppThemeBinding Light="{StaticResource Light.UpdatesTint}" Dark="{StaticResource Dark.UpdatesTint}" />
    </Color>
    <Color x:Key="Category.Other.Tint">
        <Color.AppThemeBinding Light="{StaticResource Light.OtherTint}" Dark="{StaticResource Dark.OtherTint}" />
    </Color>

</ResourceDictionary>