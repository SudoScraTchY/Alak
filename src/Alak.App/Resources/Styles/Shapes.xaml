<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:design="clr-namespace:Alak.App.Design"
                    xmlns:sys="clr-namespace:System;assembly=netstandard">

    <!-- ===== SPACING (spec §12.5) ===== -->
    <sys:Double x:Key="Spacing.XS">4</sys:Double>
    <sys:Double x:Key="Spacing.SM">8</sys:Double>
    <sys:Double x:Key="Spacing.MD">16</sys:Double>
    <sys:Double x:Key="Spacing.LG">24</sys:Double>
    <sys:Double x:Key="Spacing.XL">32</sys:Double>
    <sys:Double x:Key="Spacing.XXL">48</sys:Double>

    <!-- ===== RADIUS (spec §12.5) ===== -->
    <sys:Double x:Key="Radius.SM">8</sys:Double>
    <sys:Double x:Key="Radius.MD">12</sys:Double>
    <sys:Double x:Key="Radius.LG">16</sys:Double>
    <sys:Double x:Key="Radius.Full">999</sys:Double>

    <!-- ===== ELEVATION / SHADOWS (spec §12.5) ===== -->
    <sys:Double x:Key="Elevation.Level1">1</sys:Double>
    <sys:Double x:Key="Elevation.Level2">2</sys:Double>
    <sys:Double x:Key="Elevation.Level3">3</sys:Double>
    <sys:Double x:Key="Elevation.Level4">4</sys:Double>

    <!-- Card shadow (Level 2) -->
    <Shadow x:Key="Shadow.Card" 
            Offset="0,2" 
            Radius="8" 
            Opacity="0.08"
            Brush="{StaticResource PrimaryText}" />

    <!-- Stub shadow (Level 2) -->
    <Shadow x:Key="Shadow.Stub" 
            Offset="0,4" 
            Radius="12" 
            Opacity="0.12"
            Brush="{StaticResource PrimaryText}" />

    <!-- Modal shadow (Level 4) -->
    <Shadow x:Key="Shadow.Modal" 
            Offset="0,8" 
            Radius="24" 
            Opacity="0.16"
            Brush="{StaticResource PrimaryText}" />

    <!-- ===== STUB SHAPE (spec §12.7) ===== -->
    <!-- Ticket-shaped component with torn edge effect -->
    <Style x:Key="Frame.Stub" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource CardBackground}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.MD}" />
        <Setter Property="HasShadow" Value="True" />
        <Setter Property="Shadow" Value="{StaticResource Shadow.Stub}" />
        <Setter Property="Padding" Value="{StaticResource Spacing.MD}" />
        <Setter Property="MinimumWidthRequest" Value="280" />
        <Setter Property="MaximumWidthRequest" Value="420" />
        <Setter Property="HeightRequest" Value="140" />
        <Setter Property="BorderColor" Value="{StaticResource Divider}" />
    </Style>

    <!-- Card shape -->
    <Style x:Key="Frame.Card" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource CardBackground}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.MD}" />
        <Setter Property="HasShadow" Value="True" />
        <Setter Property="Shadow" Value="{StaticResource Shadow.Card}" />
        <Setter Property="Padding" Value="{StaticResource Spacing.MD}" />
        <Setter Property="BorderColor" Value="{StaticResource Divider}" />
    </Style>

    <!-- Sheet / Modal shape -->
    <Style x:Key="Frame.Sheet" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource CardBackground}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.LG}" />
        <Setter Property="HasShadow" Value="True" />
        <Setter Property="Shadow" Value="{StaticResource Shadow.Modal}" />
        <Setter Property="Padding" Value="{StaticResource Spacing.LG}" />
    </Style>

    <!-- Category chip -->
    <Style x:Key="Frame.Chip" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource Category.Promo.Tint}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Full}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="HasShadow" Value="False" />
        <Setter Property="BorderColor" Value="{StaticResource Divider}" />
    </Style>

    <!-- Divider -->
    <Style x:Key="BoxView.Divider" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="0.5" />
        <Setter Property="Color" Value="{StaticResource Divider}" />
        <Setter Property="Margin" Value="0,8,0,8" />
    </Style>

</ResourceDictionary>