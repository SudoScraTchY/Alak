<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:design="clr-namespace:Alak.App.Design"
             xmlns:converters="clr-namespace:Alak.App.Converters"
             x:Class="Alak.App.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Shapes.xaml" />
                <ResourceDictionary Source="Resources/Styles/Typography.xaml" />
                <ResourceDictionary Source="Resources/Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:BoolToFontWeightConverter x:Key="BoolToFontWeightConverter" />
            <converters:RelativeTimeConverter x:Key="RelativeTimeConverter" />
            <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
            <converters:CategoryLabelConverter x:Key="CategoryLabelConverter" />
            <converters:TintConverter x:Key="TintConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:StepToColorConverter x:Key="StepToColorConverter" />
            <converters:StepEqualsConverter x:Key="StepEqualsConverter" />
            <converters:StepGreaterThanConverter x:Key="StepGreaterThanConverter" />
            <converters:BoolToActiveTabColorConverter x:Key="BoolToActiveTabColorConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
