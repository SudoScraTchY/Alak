<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Alak.App.ViewModels"
             xmlns:conv="clr-namespace:Alak.App.Converters"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Alak.App.Views.WalletPage"
             x:DataType="vm:WalletViewModel"
             Title="Codes"
             BackgroundColor="{StaticResource PageBackground}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:CategoryToColorConverter x:Key="CategoryToColor" />
            <toolkit:InvertedBoolConverter x:Key="InvertedBool" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsLoading}">
        <CollectionView ItemsSource="{Binding ExpiringSoonCodes}" EmptyView="No expiring codes">
            <CollectionView.Header>
                <VerticalStackLayout Spacing="0">
                    <!-- Summary bar -->
                    <Border BackgroundColor="{StaticResource CardBackground}"
                            Stroke="{StaticResource Divider}"
                            StrokeThickness="1"
                            Margin="16,16,16,8"
                            Padding="16,12"
                            StrokeShape="RoundRectangle 12">
                        <Label Text="{Binding SummaryText}"
                               FontFamily="Vazirmatn"
                               FontSize="15"
                               TextColor="{StaticResource PrimaryText}"
                               VerticalTextAlignment="Center" />
                    </Border>

                    <!-- Expiring Soon Section -->
                    <CollectionView ItemsSource="{Binding ExpiringSoonCodes}"
                                    EmptyView="No expiring codes"
                                    HeightRequest="0">
                        <CollectionView.Header>
                            <Label Text="Expiring soon"
                                   FontFamily="Vazirmatn"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource SecondaryText}"
                                   Margin="16,16,16,8"
                                   IsVisible="{Binding ExpiringSoonCodes.Count, Converter={StaticResource BoolToVisibility}}" />
                        </CollectionView.Header>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:PromoCodeItem">
                                <Grid Margin="16,8" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                                    <!-- Main code row -->
                                    <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                            BackgroundColor="{StaticResource CardBackground}"
                                            Stroke="{StaticResource Mark.Promo}"
                                            StrokeThickness="2"
                                            StrokeShape="RoundRectangle 12"
                                            Padding="16,12">
                                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="12">
                                            <!-- Category badge -->
                                            <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="3"
                                                    BackgroundColor="{Binding Code.Kind, Converter={StaticResource CategoryToColor}}"
                                                    WidthRequest="4" HeightRequest="56"
                                                    StrokeShape="RoundRectangle 2"
                                                    VerticalOptions="Fill" />

                                            <!-- Code display -->
                                            <Label Grid.Row="0" Grid.Column="1"
                                                   Text="{Binding Code.DisplayCode}"
                                                   FontFamily="JetBrains Mono"
                                                   FontSize="20"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource PrimaryText}"
                                                   VerticalTextAlignment="Center" />

                                            <!-- Copy button -->
                                            <Button Grid.Row="0" Grid.Column="2"
                                                    Text="Copy"
                                                    FontFamily="Vazirmatn"
                                                    FontSize="12"
                                                    FontAttributes="Bold"
                                                    BackgroundColor="{StaticResource Mark.Promo}"
                                                    TextColor="{StaticResource OnAccent}"
                                                    CornerRadius="8"
                                                    Padding="12,6"
                                                    HeightRequest="36"
                                                    VerticalOptions="Center"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WalletViewModel}}, Path=CopyCodeCommand}"
                                                    CommandParameter="{Binding}" />

                                            <!-- Kind + Discount -->
                                            <Label Grid.Row="1" Grid.Column="1"
                                                   Text="{Binding DiscountText, StringFormat='{0} · {1}', FallbackValue='{0}'}"
                                                   FontFamily="Vazirmatn"
                                                   FontSize="13"
                                                   TextColor="{StaticResource SecondaryText}"
                                                   VerticalTextAlignment="Center">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding KindText}" FontAttributes="Bold" TextColor="{StaticResource SecondaryText}" />
                                                        <Span Text=" · " TextColor="{StaticResource TertiaryText}" />
                                                        <Span Text="{Binding DiscountText}" TextColor="{StaticResource SecondaryText}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>

                                            <!-- Source + Expiry -->
                                            <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                <Label Grid.Column="0"
                                                       Text="{Binding SourceDisplay}"
                                                       FontFamily="Vazirmatn"
                                                       FontSize="12"
                                                       TextColor="{StaticResource TertiaryText}" />
                                                <Label Grid.Column="1"
                                                       Text="{Binding ValidUntilText}"
                                                       FontFamily="Vazirmatn"
                                                       FontSize="12"
                                                       TextColor="{StaticResource Mark.Danger}"
                                                       FontAttributes="Bold"
                                                       HorizontalTextAlignment="End" />
                                                <Label Grid.Column="2"
                                                       Text="⏰"
                                                       FontSize="14"
                                                       IsVisible="{Binding HasReminder}"
                                                       VerticalTextAlignment="Center" />
                                            </Grid>

                                            <!-- Reminder text -->
                                            <Label Grid.Row="3" Grid.Column="1"
                                                   Text="{Binding ReminderText}"
                                                   FontFamily="Vazirmatn"
                                                   FontSize="11"
                                                   TextColor="{StaticResource TertiaryText}"
                                                   IsVisible="{Binding HasReminder}" />
                                        </Grid>
                                    </Border>

                                    <!-- Action buttons -->
                                    <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                          ColumnDefinitions="*,*,*" ColumnSpacing="8"
                                          Margin="0,8,0,0"
                                          IsVisible="{Binding IsUsed, Converter={StaticResource InvertedBool}}">
                                        <Button Grid.Column="0"
                                                Text="Mark Used"
                                                FontFamily="Vazirmatn"
                                                FontSize="12"
                                                BackgroundColor="{StaticResource Surface}"
                                                TextColor="{StaticResource PrimaryText}"
                                                CornerRadius="8"
                                                HeightRequest="36"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WalletViewModel}}, Path=MarkUsedCommand}"
                                                CommandParameter="{Binding}" />
                                        <Button Grid.Column="1"
                                                Text="Dismiss"
                                                FontFamily="Vazirmatn"
                                                FontSize="12"
                                                BackgroundColor="{StaticResource Surface}"
                                                TextColor="{StaticResource SecondaryText}"
                                                CornerRadius="8"
                                                HeightRequest="36"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WalletViewModel}}, Path=DismissCommand}"
                                                CommandParameter="{Binding}" />
                                        <Button Grid.Column="2"
                                                Text="Remind"
                                                FontFamily="Vazirmatn"
                                                FontSize="12"
                                                BackgroundColor="{StaticResource Surface}"
                                                TextColor="{StaticResource SecondaryText}"
                                                CornerRadius="8"
                                                HeightRequest="36"
                                                IsVisible="{Binding Code.HasValidUntil}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WalletViewModel}}, Path=SetReminderCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>

                                    <!-- Undo for dismissed -->
                                    <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                            Text="Undo dismiss"
                                            FontFamily="Vazirmatn"
                                            FontSize="12"
                                            BackgroundColor="Transparent"
                                            TextColor="{StaticResource Mark.Promo}"
                                            HeightRequest="36"
                                            IsVisible="{Binding IsDismissed}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WalletViewModel}}, Path=UndoDismissCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Active Codes Section -->
                    <CollectionView ItemsSource="{Binding ActiveCodes}"
                                    EmptyView="No active codes">
                        <CollectionView.Header>
                            <Label Text="Active"
                                   FontFamily="Vazirmatn"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource SecondaryText}"
                                   Margin="16,16,16,8"
                                   IsVisible="{Binding ActiveCodes.Count, Converter={StaticResource BoolToVisibility}}" />
                        </CollectionView.Header>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:PromoCodeItem">
                                <Grid Margin="16,8" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                                    <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                            BackgroundColor="{StaticResource CardBackground}"
                                            Stroke="{StaticResource Divider}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 12"
                                            Padding="16,12">
                                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="12">
                                            <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="3"
                                                    BackgroundColor="{Binding Code.Kind, Converter={StaticResource CategoryToColor}}"
                                                    WidthRequest="4" HeightRequest="56"
                                                    StrokeShape="RoundRectangle 2"
                                                    VerticalOptions="Fill" />

                                            <Label Grid.Row="0" Grid.Column="1"
                                                   Text="{Binding Code.DisplayCode}"
                                                   FontFamily="JetBrains Mono"
                                                   FontSize="20"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource PrimaryText}"
                                                   VerticalTextAlignment="Center" />

                                            <Button Grid.Row="0" Grid.Column="2"
                                                    Text="Copy"
                                                    FontFamily="Vazirmatn"
                                                    FontSize="12"
                                                    FontAttributes="Bold"
                                                    BackgroundColor="{StaticResource Mark.Promo}"
                                                    TextColor="{StaticResource OnAccent}"
                                                    CornerRadius="8"
                                                    Padding="12,6"
                                                    HeightRequest="36"
                                                    VerticalOptions="Center"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WalletViewModel}}, Path=CopyCodeCommand}"
                                                    CommandParameter="{Binding}" />

                                            <Label Grid.Row="1" Grid.Column="1">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding KindText}" FontAttributes="Bold" TextColor="{StaticResource SecondaryText}" />
                                                        <Span Text=" · " TextColor="{StaticResource TertiaryText}" />
                                                        <Span Text="{Binding DiscountText}" TextColor="{StaticResource SecondaryText}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>

                                            <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                <Label Grid.Column="0"
                                                       Text="{Binding SourceDisplay}"
                                                       FontFamily="Vazirmatn"
                                                       FontSize="12"
                                                       TextColor="{StaticResource TertiaryText}" />
                                                <Label Grid.Column="1"
                                                       Text="{Binding ValidUntilText}"
                                                       FontFamily="Vazirmatn"
                                                       FontSize="12"
                                                       TextColor="{StaticResource SecondaryText}"
                                                       HorizontalTextAlignment="End" />
                                                <Label Grid.Column="2"
                                                       Text="⏰"
                                                       FontSize="14"
                                                       IsVisible="{Binding HasReminder}"
                                                       VerticalTextAlignment="Center" />
                                            </Grid>

                                            <Label Grid.Row="3" Grid.Column="1"
                                                   Text="{Binding ReminderText}"
                                                   FontFamily="Vazirmatn"
                                                   FontSize="11"
                                                   TextColor="{StaticResource TertiaryText}"
                                                   IsVisible="{Binding HasReminder}" />
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                          ColumnDefinitions="*,*,*" ColumnSpacing="8"
                                          Margin="0,8,0,0">
                                        <Button Grid.Column="0"
                                                Text="Mark Used"
                                                FontFamily="Vazirmatn"
                                                FontSize="12"
                                                BackgroundColor="{StaticResource Surface}"
                                                TextColor="{StaticResource PrimaryText}"
                                                CornerRadius="8"
                                                HeightRequest="36"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WalletViewModel}}, Path=MarkUsedCommand}"
                                                CommandParameter="{Binding}" />
                                        <Button Grid.Column="1"
                                                Text="Dismiss"
                                                FontFamily="Vazirmatn"
                                                FontSize="12"
                                                BackgroundColor="{StaticResource Surface}"
                                                TextColor="{StaticResource SecondaryText}"
                                                CornerRadius="8"
                                                HeightRequest="36"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WalletViewModel}}, Path=DismissCommand}"
                                                CommandParameter="{Binding}" />
                                        <Button Grid.Column="2"
                                                Text="Remind"
                                                FontFamily="Vazirmatn"
                                                FontSize="12"
                                                BackgroundColor="{StaticResource Surface}"
                                                TextColor="{StaticResource SecondaryText}"
                                                CornerRadius="8"
                                                HeightRequest="36"
                                                IsVisible="{Binding Code.HasValidUntil}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WalletViewModel}}, Path=SetReminderCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Used Codes Section -->
                    <CollectionView ItemsSource="{Binding UsedCodes}"
                                    EmptyView="No used codes">
                        <CollectionView.Header>
                            <Label Text="Used"
                                   FontFamily="Vazirmatn"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource SecondaryText}"
                                   Margin="16,16,16,8"
                                   IsVisible="{Binding UsedCodes.Count, Converter={StaticResource BoolToVisibility}}" />
                        </CollectionView.Header>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:PromoCodeItem">
                                <Border Margin="16,8"
                                        BackgroundColor="{StaticResource CardBackground}"
                                        Stroke="{StaticResource Divider}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="16,12"
                                        Opacity="0.7">
                                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4" ColumnSpacing="12">
                                        <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                                                BackgroundColor="{StaticResource Mark.Success}"
                                                WidthRequest="4" HeightRequest="48"
                                                StrokeShape="RoundRectangle 2"
                                                VerticalOptions="Fill" />

                                        <Label Grid.Row="0" Grid.Column="1"
                                               Text="{Binding Code.DisplayCode}"
                                               FontFamily="JetBrains Mono"
                                               FontSize="18"
                                               TextColor="{StaticResource PrimaryText}"
                                               VerticalTextAlignment="Center"
                                               TextDecorations="Strikethrough" />

                                        <Label Grid.Row="1" Grid.Column="1"
                                               Text="{Binding SourceDisplay}"
                                               FontFamily="Vazirmatn"
                                               FontSize="12"
                                               TextColor="{StaticResource TertiaryText}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Dismissed Codes Section -->
                    <CollectionView ItemsSource="{Binding DismissedCodes}"
                                    EmptyView="No dismissed codes">
                        <CollectionView.Header>
                            <Label Text="Dismissed"
                                   FontFamily="Vazirmatn"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource SecondaryText}"
                                   Margin="16,16,16,8"
                                   IsVisible="{Binding DismissedCodes.Count, Converter={StaticResource BoolToVisibility}}" />
                        </CollectionView.Header>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:PromoCodeItem">
                                <Border Margin="16,8"
                                        BackgroundColor="{StaticResource CardBackground}"
                                        Stroke="{StaticResource Divider}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="16,12"
                                        Opacity="0.6">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4" ColumnSpacing="12">
                                        <Grid Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                            <Border BackgroundColor="{StaticResource Mark.Danger}"
                                                    WidthRequest="4" HeightRequest="48"
                                                    StrokeShape="RoundRectangle 2"
                                                    VerticalOptions="Fill" />

                                            <Label Grid.Column="1"
                                                   Text="{Binding Code.DisplayCode}"
                                                   FontFamily="JetBrains Mono"
                                                   FontSize="18"
                                                   TextColor="{StaticResource PrimaryText}"
                                                   VerticalTextAlignment="Center"
                                                   TextDecorations="Strikethrough" />
                                        </Grid>

                                        <Label Grid.Row="1" Grid.Column="0"
                                               Text="{Binding SourceDisplay}"
                                               FontFamily="Vazirmatn"
                                               FontSize="12"
                                               TextColor="{StaticResource TertiaryText}" />

                                        <Button Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                                                Text="Undo"
                                                FontFamily="Vazirmatn"
                                                FontSize="12"
                                                BackgroundColor="{StaticResource Mark.Promo}"
                                                TextColor="{StaticResource OnAccent}"
                                                CornerRadius="8"
                                                Padding="16,0"
                                                HeightRequest="36"
                                                VerticalOptions="Center"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WalletViewModel}}, Path=UndoDismissCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Expired Codes Section (collapsible) -->
                    <Border Margin="16,8,16,16"
                            BackgroundColor="{StaticResource CardBackground}"
                            Stroke="{StaticResource Divider}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            IsVisible="{Binding ShowExpiredSection}">
                        <VerticalStackLayout Spacing="0">
                            <Button Text="{Binding ShowExpiredSection, Converter={StaticResource InvertedBool}, ConverterParameter='Show expired ({0})', StringFormat='Show expired ({0})'}"
                                    FontFamily="Vazirmatn"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource SecondaryText}"
                                    HorizontalOptions="Start"
                                    Padding="16,12"
                                    Command="{Binding ToggleExpiredSectionCommand}" />

                            <CollectionView ItemsSource="{Binding ExpiredCodes}"
                                            EmptyView="No expired codes"
                                            HeightRequest="0">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PromoCodeItem">
                                        <Border Margin="16,4,16,8"
                                                BackgroundColor="{StaticResource Surface}"
                                                Stroke="{StaticResource Divider}"
                                                StrokeThickness="1"
                                                StrokeShape="RoundRectangle 8"
                                                Padding="12,8"
                                                Opacity="0.5">
                                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto" ColumnSpacing="12">
                                                <Border BackgroundColor="{StaticResource TertiaryText}"
                                                        WidthRequest="3" HeightRequest="40"
                                                        StrokeShape="RoundRectangle 2"
                                                        VerticalOptions="Fill" />

                                                <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="2">
                                                    <Label Grid.Row="0"
                                                           Text="{Binding Code.DisplayCode}"
                                                           FontFamily="JetBrains Mono"
                                                           FontSize="16"
                                                           TextColor="{StaticResource TertiaryText}"
                                                           TextDecorations="Strikethrough" />
                                                    <Label Grid.Row="1"
                                                           Text="{Binding SourceDisplay}"
                                                           FontFamily="Vazirmatn"
                                                           FontSize="11"
                                                           TextColor="{StaticResource TertiaryText}" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:PromoCodeItem">
                    <Grid Margin="16,8" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                BackgroundColor="{StaticResource CardBackground}"
                                Stroke="{StaticResource Mark.Promo}"
                                StrokeThickness="2"
                                StrokeShape="RoundRectangle 12"
                                Padding="16,12">
                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="12">
                                <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="3"
                                        BackgroundColor="{Binding Code.Kind, Converter={StaticResource CategoryToColor}}"
                                        WidthRequest="4" HeightRequest="56"
                                        StrokeShape="RoundRectangle 2"
                                        VerticalOptions="Fill" />

                                <Label Grid.Row="0" Grid.Column="1"
                                       Text="{Binding Code.DisplayCode}"
                                       FontFamily="JetBrains Mono"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource PrimaryText}"
                                       VerticalTextAlignment="Center" />

                                <Button Grid.Row="0" Grid.Column="2"
                                        Text="Copy"
                                        FontFamily="Vazirmatn"
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        BackgroundColor="{StaticResource Mark.Promo}"
                                        TextColor="{StaticResource OnAccent}"
                                        CornerRadius="8"
                                        Padding="12,6"
                                        HeightRequest="36"
                                        VerticalOptions="Center"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WalletViewModel}}, Path=CopyCodeCommand}"
                                        CommandParameter="{Binding}" />

                                <Label Grid.Row="1" Grid.Column="1">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding KindText}" FontAttributes="Bold" TextColor="{StaticResource SecondaryText}" />
                                            <Span Text=" · " TextColor="{StaticResource TertiaryText}" />
                                            <Span Text="{Binding DiscountText}" TextColor="{StaticResource SecondaryText}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <Label Grid.Column="0"
                                           Text="{Binding SourceDisplay}"
                                           FontFamily="Vazirmatn"
                                           FontSize="12"
                                           TextColor="{StaticResource TertiaryText}" />
                                    <Label Grid.Column="1"
                                           Text="{Binding ValidUntilText}"
                                           FontFamily="Vazirmatn"
                                           FontSize="12"
                                           TextColor="{StaticResource Mark.Danger}"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="End" />
                                    <Label Grid.Column="2"
                                           Text="⏰"
                                           FontSize="14"
                                           IsVisible="{Binding HasReminder}"
                                           VerticalTextAlignment="Center" />
                                </Grid>

                                <Label Grid.Row="3" Grid.Column="1"
                                       Text="{Binding ReminderText}"
                                       FontFamily="Vazirmatn"
                                       FontSize="11"
                                       TextColor="{StaticResource TertiaryText}"
                                       IsVisible="{Binding HasReminder}" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                              ColumnDefinitions="*,*,*" ColumnSpacing="8"
                              Margin="0,8,0,0">
                            <Button Grid.Column="0"
                                    Text="Mark Used"
                                    FontFamily="Vazirmatn"
                                    FontSize="12"
                                    BackgroundColor="{StaticResource Surface}"
                                    TextColor="{StaticResource PrimaryText}"
                                    CornerRadius="8"
                                    HeightRequest="36"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WalletViewModel}}, Path=MarkUsedCommand}"
                                    CommandParameter="{Binding}" />
                            <Button Grid.Column="1"
                                    Text="Dismiss"
                                    FontFamily="Vazirmatn"
                                    FontSize="12"
                                    BackgroundColor="{StaticResource Surface}"
                                    TextColor="{StaticResource SecondaryText}"
                                    CornerRadius="8"
                                    HeightRequest="36"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WalletViewModel}}, Path=DismissCommand}"
                                    CommandParameter="{Binding}" />
                            <Button Grid.Column="2"
                                    Text="Remind"
                                    FontFamily="Vazirmatn"
                                    FontSize="12"
                                    BackgroundColor="{StaticResource Surface}"
                                    TextColor="{StaticResource SecondaryText}"
                                    CornerRadius="8"
                                    HeightRequest="36"
                                    IsVisible="{Binding Code.HasValidUntil}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WalletViewModel}}, Path=SetReminderCommand}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</ContentPage>
