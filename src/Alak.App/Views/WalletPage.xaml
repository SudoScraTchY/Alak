<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Alak.App.ViewModels"
             xmlns:conv="clr-namespace:Alak.App.Converters"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Alak.App.Views.WalletPage"
             x:DataType="vm:WalletViewModel"
             Title="Codes"
             BackgroundColor="{AppThemeBinding Light={StaticResource Salt}, Dark={StaticResource Night}}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:CategoryToColorConverter x:Key="CategoryToColor" />
            <toolkit:InvertedBoolConverter x:Key="InvertedBool" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <!--
        Codes wallet (SPEC §13.4 + §12.7). The Stub is the signature component:
        ticket-shaped (squared top-left corner, dashed/perforated stroke in the
        code's kind color), mono code, gold accent. Sections render via
        BindableLayout in the header/footer; the main CollectionView lists active
        codes. The previous version nested CollectionViews inside the header with
        HeightRequest=0 visibility hacks and duplicated every template five times.
    -->
    <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsLoading}"
                 Style="{StaticResource RefreshView.Standard}">
        <CollectionView ItemsSource="{Binding ActiveCodes}"
                        Style="{StaticResource CollectionView.Inbox}">

            <CollectionView.Header>
                <VerticalStackLayout Spacing="0" Padding="0,8,0,4">

                    <!-- Summary line -->
                    <Label Text="{Binding SummaryText}"
                           Style="{StaticResource Text.BodySecondary}"
                           Margin="16,8,16,4" />

                    <!-- ===== EXPIRING SOON ===== -->
                    <Label Text="Expiring soon"
                           Style="{StaticResource Text.Section}"
                           Margin="16,12,16,4"
                           IsVisible="{Binding ExpiringSoonCodes.Count, Converter={StaticResource BoolToVisibility}}" />
                    <VerticalStackLayout Spacing="0" Margin="0,0,0,8"
                                         BindableLayout.ItemsSource="{Binding ExpiringSoonCodes}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:PromoCodeItem">
                                <Border Style="{StaticResource Stub.Border}"
                                        Stroke="{Binding Code.Kind, Converter={StaticResource CategoryToColor}}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WalletViewModel}}, Path=ViewDetailsCommand}"
                                                              CommandParameter="{Binding}" />
                                    </Border.GestureRecognizers>
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                                        <!-- kind + source -->
                                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                            <BoxView Grid.Column="0" WidthRequest="8" HeightRequest="8" CornerRadius="4"
                                                     VerticalOptions="Center"
                                                     Color="{Binding Code.Kind, Converter={StaticResource CategoryToColor}}" />
                                            <Label Grid.Column="1" Text="{Binding SourceDisplay}" Style="{StaticResource Text.Caption}"
                                                   VerticalOptions="Center" MaxLines="1" LineBreakMode="TailTruncation" />
                                            <Label Grid.Column="2" Text="{Binding KindText}" Style="{StaticResource Text.Caption}"
                                                   FontFamily="{StaticResource Font.SemiBold}" VerticalOptions="Center" />
                                        </Grid>

                                        <!-- the code, mono + copy -->
                                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Label Grid.Column="0" Text="{Binding Code.DisplayCode}"
                                                   Style="{StaticResource Text.Code}" FontSize="17"
                                                   VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                            <Border Grid.Column="1" Style="{StaticResource Chip.Category}"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource Tint.Wallet}, Dark={StaticResource Tint.Wallet.Dark}}"
                                                    VerticalOptions="Center">
                                                <Label Text="Copy" FontFamily="{StaticResource Font.SemiBold}" FontSize="12"
                                                       TextColor="{AppThemeBinding Light={StaticResource Mark.Wallet}, Dark={StaticResource Mark.Wallet.Dark}}">
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WalletViewModel}}, Path=CopyCodeCommand}"
                                                                              CommandParameter="{Binding}" />
                                                    </Label.GestureRecognizers>
                                                </Label>
                                            </Border>
                                        </Grid>

                                        <!-- value + expiry -->
                                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Label Grid.Column="0" Text="{Binding DiscountText}" Style="{StaticResource Text.BodySecondary}"
                                                   MaxLines="1" LineBreakMode="TailTruncation" />
                                            <Label Grid.Column="1" Text="{Binding ValidUntilText}" Style="{StaticResource Text.Caption}"
                                                   TextColor="{StaticResource Mark.Danger}" FontFamily="{StaticResource Font.SemiBold}"
                                                   IsVisible="{Binding Code.HasValidUntil}" />
                                        </Grid>

                                        <!-- expiry drain bar -->
                                        <BoxView Grid.Row="3" HeightRequest="3" CornerRadius="1.5"
                                                 Color="{Binding Code.Kind, Converter={StaticResource CategoryToColor}}"
                                                 IsVisible="{Binding Code.HasValidUntil}" />

                                        <!-- quiet actions -->
                                        <Grid Grid.Row="4" ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="4">
                                            <Label Grid.Column="0" Text="Mark used" Style="{StaticResource Text.Caption}"
                                                   FontFamily="{StaticResource Font.SemiBold}"
                                                   TextColor="{AppThemeBinding Light={StaticResource Ink2}, Dark={StaticResource Txt2}}"
                                                   IsVisible="{Binding IsUsed, Converter={StaticResource InvertedBool}}">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WalletViewModel}}, Path=MarkUsedCommand}"
                                                                          CommandParameter="{Binding}" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                            <Label Grid.Column="1" Text="Remind" Style="{StaticResource Text.Caption}"
                                                   FontFamily="{StaticResource Font.SemiBold}"
                                                   TextColor="{AppThemeBinding Light={StaticResource Ink2}, Dark={StaticResource Txt2}}"
                                                   IsVisible="{Binding Code.HasValidUntil}">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WalletViewModel}}, Path=SetReminderCommand}"
                                                                          CommandParameter="{Binding}" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                            <Label Grid.Column="2" Text="Dismiss" Style="{StaticResource Text.Caption}"
                                                   FontFamily="{StaticResource Font.SemiBold}"
                                                   TextColor="{AppThemeBinding Light={StaticResource Ink3}, Dark={StaticResource Txt3}}"
                                                   IsVisible="{Binding IsDismissed, Converter={StaticResource InvertedBool}}">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WalletViewModel}}, Path=DismissCommand}"
                                                                          CommandParameter="{Binding}" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                            <Label Grid.Column="3" Text="{Binding ReminderText}" Style="{StaticResource Text.Caption}"
                                                   IsVisible="{Binding HasReminder}" VerticalOptions="Center" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:PromoCodeItem">
                    <Border Style="{StaticResource Stub.Border}"
                            Stroke="{Binding Code.Kind, Converter={StaticResource CategoryToColor}}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WalletViewModel}}, Path=ViewDetailsCommand}"
                                                  CommandParameter="{Binding}" />
                        </Border.GestureRecognizers>
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                            <!-- kind + source -->
                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <BoxView Grid.Column="0" WidthRequest="8" HeightRequest="8" CornerRadius="4"
                                         VerticalOptions="Center"
                                         Color="{Binding Code.Kind, Converter={StaticResource CategoryToColor}}" />
                                <Label Grid.Column="1" Text="{Binding SourceDisplay}" Style="{StaticResource Text.Caption}"
                                       VerticalOptions="Center" MaxLines="1" LineBreakMode="TailTruncation" />
                                <Label Grid.Column="2" Text="{Binding KindText}" Style="{StaticResource Text.Caption}"
                                       FontFamily="{StaticResource Font.SemiBold}" VerticalOptions="Center" />
                            </Grid>

                            <!-- the code, mono + copy -->
                            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="{Binding Code.DisplayCode}"
                                       Style="{StaticResource Text.Code}" FontSize="17"
                                       VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                <Border Grid.Column="1" Style="{StaticResource Chip.Category}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Tint.Wallet}, Dark={StaticResource Tint.Wallet.Dark}}"
                                        VerticalOptions="Center">
                                    <Label Text="Copy" FontFamily="{StaticResource Font.SemiBold}" FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource Mark.Wallet}, Dark={StaticResource Mark.Wallet.Dark}}">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WalletViewModel}}, Path=CopyCodeCommand}"
                                                                  CommandParameter="{Binding}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Border>
                            </Grid>

                            <!-- value + expiry -->
                            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="{Binding DiscountText}" Style="{StaticResource Text.BodySecondary}"
                                       MaxLines="1" LineBreakMode="TailTruncation" />
                                <Label Grid.Column="1" Text="{Binding ValidUntilText}" Style="{StaticResource Text.Caption}"
                                       FontFamily="{StaticResource Font.SemiBold}"
                                       IsVisible="{Binding Code.HasValidUntil}" />
                            </Grid>

                            <!-- expiry drain bar -->
                            <BoxView Grid.Row="3" HeightRequest="3" CornerRadius="1.5"
                                     Color="{Binding Code.Kind, Converter={StaticResource CategoryToColor}}"
                                     IsVisible="{Binding Code.HasValidUntil}" />

                            <!-- quiet actions -->
                            <Grid Grid.Row="4" ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12">
                                <Label Grid.Column="0" Text="Mark used" Style="{StaticResource Text.Caption}"
                                       FontFamily="{StaticResource Font.SemiBold}"
                                       TextColor="{AppThemeBinding Light={StaticResource Ink2}, Dark={StaticResource Txt2}}"
                                       IsVisible="{Binding IsUsed, Converter={StaticResource InvertedBool}}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WalletViewModel}}, Path=MarkUsedCommand}"
                                                              CommandParameter="{Binding}" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Label Grid.Column="1" Text="Remind" Style="{StaticResource Text.Caption}"
                                       FontFamily="{StaticResource Font.SemiBold}"
                                       TextColor="{AppThemeBinding Light={StaticResource Ink2}, Dark={StaticResource Txt2}}"
                                       IsVisible="{Binding Code.HasValidUntil}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WalletViewModel}}, Path=SetReminderCommand}"
                                                              CommandParameter="{Binding}" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Label Grid.Column="2" Text="Dismiss" Style="{StaticResource Text.Caption}"
                                       FontFamily="{StaticResource Font.SemiBold}"
                                       TextColor="{AppThemeBinding Light={StaticResource Ink3}, Dark={StaticResource Txt3}}"
                                       IsVisible="{Binding IsDismissed, Converter={StaticResource InvertedBool}}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WalletViewModel}}, Path=DismissCommand}"
                                                              CommandParameter="{Binding}" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Label Grid.Column="3" Text="{Binding ReminderText}" Style="{StaticResource Text.Caption}"
                                       IsVisible="{Binding HasReminder}" VerticalOptions="Center" />
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout Spacing="12" Padding="32" VerticalOptions="Center">
                    <Label Text="الک"
                           FontFamily="{StaticResource Font.Medium}"
                           FontSize="72"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Ink3}, Dark={StaticResource Txt3}}"
                           Opacity="0.45" />
                    <Label Text="No codes yet"
                           Style="{StaticResource Text.Title}"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                    <Label Text="Promo codes Alak finds in your notifications are kept here — with expiry, never lost."
                           Style="{StaticResource Text.BodySecondary}"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.Footer>
                <VerticalStackLayout Spacing="0" Padding="0,4,0,24">

                    <!-- ===== USED ===== -->
                    <Label Text="Used"
                           Style="{StaticResource Text.Section}"
                           Margin="16,16,16,4"
                           IsVisible="{Binding UsedCodes.Count, Converter={StaticResource BoolToVisibility}}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding UsedCodes}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:PromoCodeItem">
                                <Border Style="{StaticResource Card.Row}" Opacity="0.65">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <BoxView Grid.Column="0" WidthRequest="3" Color="{StaticResource Mark.Success}"
                                                 VerticalOptions="Fill" />
                                        <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="2">
                                            <Label Grid.Row="0" Text="{Binding Code.DisplayCode}"
                                                   FontFamily="{StaticResource Font.Mono}" FontSize="15"
                                                   TextDecorations="Strikethrough"
                                                   TextColor="{AppThemeBinding Light={StaticResource Ink2}, Dark={StaticResource Txt2}}" />
                                            <Label Grid.Row="1" Text="{Binding SourceDisplay}" Style="{StaticResource Text.Caption}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- ===== DISMISSED ===== -->
                    <Label Text="Dismissed"
                           Style="{StaticResource Text.Section}"
                           Margin="16,16,16,4"
                           IsVisible="{Binding DismissedCodes.Count, Converter={StaticResource BoolToVisibility}}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding DismissedCodes}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:PromoCodeItem">
                                <Border Style="{StaticResource Card.Row}" Opacity="0.6">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <BoxView Grid.Column="0" WidthRequest="3" Color="{StaticResource Mark.Danger}"
                                                 VerticalOptions="Fill" />
                                        <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="2">
                                            <Label Grid.Row="0" Text="{Binding Code.DisplayCode}"
                                                   FontFamily="{StaticResource Font.Mono}" FontSize="15"
                                                   TextDecorations="Strikethrough"
                                                   TextColor="{AppThemeBinding Light={StaticResource Ink2}, Dark={StaticResource Txt2}}" />
                                            <Label Grid.Row="1" Text="{Binding SourceDisplay}" Style="{StaticResource Text.Caption}" />
                                        </Grid>
                                        <Label Grid.Column="2" Text="Undo" VerticalOptions="Center"
                                               FontFamily="{StaticResource Font.SemiBold}" FontSize="13"
                                               TextColor="{AppThemeBinding Light={StaticResource Mark.Wallet}, Dark={StaticResource Mark.Wallet.Dark}}">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WalletViewModel}}, Path=UndoDismissCommand}"
                                                                      CommandParameter="{Binding}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- ===== EXPIRED (collapsible) ===== -->
                    <Border IsVisible="{Binding ExpiredCodes.Count, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource Card.Row}" Margin="16,16,16,0" Padding="0">
                        <VerticalStackLayout Spacing="0">
                            <Label Text="{Binding ExpiredCodes.Count, StringFormat='Expired ({0})'}"
                                   Style="{StaticResource Text.Section}"
                                   Padding="14,12">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleExpiredSectionCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                            <VerticalStackLayout Spacing="0" Padding="0,0,0,8"
                                                 IsVisible="{Binding ShowExpiredSection}"
                                                 BindableLayout.ItemsSource="{Binding ExpiredCodes}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PromoCodeItem">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Padding="14,4,14,4" Opacity="0.5">
                                            <BoxView Grid.Column="0" WidthRequest="3" Color="{AppThemeBinding Light={StaticResource Ink3}, Dark={StaticResource Txt3}}"
                                                     VerticalOptions="Fill" />
                                            <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="2">
                                                <Label Grid.Row="0" Text="{Binding Code.DisplayCode}"
                                                       FontFamily="{StaticResource Font.Mono}" FontSize="14"
                                                       TextDecorations="Strikethrough"
                                                       TextColor="{AppThemeBinding Light={StaticResource Ink3}, Dark={StaticResource Txt3}}" />
                                                <Label Grid.Row="1" Text="{Binding SourceDisplay}" Style="{StaticResource Text.Caption}" />
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </CollectionView.Footer>
        </CollectionView>
    </RefreshView>
</ContentPage>
