<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Alak.App.ViewModels"
             xmlns:controls="clr-namespace:Alak.App.Controls"
             xmlns:services="clr-namespace:Alak.App.Services"
             x:Class="Alak.App.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource Salt}, Dark={StaticResource Night}}"
             Shell.NavBarIsVisible="False"
             FlowDirection="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=CurrentFlowDirection}"
             Title="Settings">
    <ScrollView>
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="20" Margin="16,16,16,24">
            <!-- General -->
            <Border Grid.Row="0" Style="{StaticResource Card.Row}" Padding="16">
                <VerticalStackLayout Spacing="16">
                    <Label Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_General]}" Style="{StaticResource Text.Label}" />
                    
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_Notifications]}" Style="{StaticResource Text.Body}" />
                            <Label Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_NotificationsDesc]}" Style="{StaticResource Text.Caption}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" 
                                IsToggled="{Binding NotificationsEnabled}"
                                Style="{StaticResource Switch.Standard}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_AdaptiveLearning]}" Style="{StaticResource Text.Body}" />
                            <Label Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_AdaptiveLearningDesc]}" Style="{StaticResource Text.Caption}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" 
                                IsToggled="{Binding AdaptiveLearningEnabled}"
                                Style="{StaticResource Switch.Standard}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_RtlLayout]}" Style="{StaticResource Text.Body}" />
                            <Label Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_RtlLayoutDesc]}" Style="{StaticResource Text.Caption}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" 
                                IsToggled="{Binding RtlLayoutEnabled}"
                                Style="{StaticResource Switch.Standard}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Global Settings (spec §11.4) -->
            <Border Grid.Row="1" Style="{StaticResource Card.Row}" Padding="16">
                <VerticalStackLayout Spacing="16">
                    <Label Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_Global]}" Style="{StaticResource Text.Label}" />

                    <controls:OptionComboBox Title="Theme"
                                             Options="system,light,dark"
                                             OptionLabels="System,Light,Dark"
                                             SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" />

                    <controls:OptionComboBox Title="UI Language"
                                             Options="system,en,fa"
                                             OptionLabels="System,English,فارسی"
                                             SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" />

                    <controls:OptionComboBox Title="Calendar"
                                             Options="auto,gregorian,jalali"
                                             OptionLabels="Auto,Gregorian,Jalali"
                                             SelectedItem="{Binding SelectedCalendar, Mode=TwoWay}" />

                    <controls:OptionComboBox Title="Digits"
                                             Options="auto,latin,persian"
                                             OptionLabels="Auto,Latin,Persian"
                                             SelectedItem="{Binding SelectedDigits, Mode=TwoWay}" />

                    <controls:OptionComboBox Title="SLM Performance Profile"
                                             Options="battery,balanced,quality"
                                             OptionLabels="Battery,Balanced,Quality"
                                             SelectedItem="{Binding SelectedPerformanceProfile, Mode=TwoWay}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_Tier2]}" Style="{StaticResource Text.Body}" />
                            <Label Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_Tier2Desc]}" Style="{StaticResource Text.Caption}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" 
                                IsToggled="{Binding Tier2Enabled}"
                                Style="{StaticResource Switch.Standard}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- SLM On-Device Model Manager -->
            <Border Grid.Row="2" Style="{StaticResource Card.Row}" Padding="16">
                <VerticalStackLayout Spacing="14">
                    <Label Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_SlmModel]}" Style="{StaticResource Text.Label}" />

                    <VerticalStackLayout Spacing="4">
                        <Label Text="SmolLM2-135M-Instruct (Q4_K_M GGUF)" Style="{StaticResource Text.Body}" FontAttributes="Bold" />
                        <Label Text="{Binding ModelStatusText}" Style="{StaticResource Text.Caption}" TextColor="{AppThemeBinding Light={StaticResource Mark.Work}, Dark={StaticResource Tint.Work.Dark}}" />
                    </VerticalStackLayout>

                    <ProgressBar Progress="{Binding ModelDownloadProgress}"
                                 IsVisible="{Binding IsModelDownloading}"
                                 ProgressColor="{AppThemeBinding Light={StaticResource Mark.Work}, Dark={StaticResource Mark.Work.Dark}}"
                                 HeightRequest="6" />

                    <Button Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_ImportModel]}"
                            Style="{StaticResource Button.Primary}"
                            Command="{Binding ImportModelCommand}"
                            IsVisible="{Binding IsModelDownloaded, Converter={StaticResource InverseBoolConverter}}"
                            IsEnabled="{Binding IsModelDownloading, Converter={StaticResource InverseBoolConverter}}"
                            HorizontalOptions="Fill" />

                    <Button Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_TestInference]}"
                            Style="{StaticResource Button.Secondary}"
                            Command="{Binding RunBenchmarkCommand}"
                            IsVisible="{Binding IsModelDownloaded}"
                            HorizontalOptions="Fill" />

                    <Button Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_ManageModels]}"
                            Style="{StaticResource Button.Secondary}"
                            Command="{Binding OpenModelsCommand}"
                            HorizontalOptions="Fill" />

                    <Label Text="{Binding BenchmarkResult}"
                           Style="{StaticResource Text.Caption}"
                           IsVisible="{Binding BenchmarkResult, Converter={StaticResource StringNotEmptyConverter}}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Display and Privacy -->
            <Border Grid.Row="3" Style="{StaticResource Card.Row}" Padding="16">
                <VerticalStackLayout Spacing="16">
                    <Label Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_DisplayPrivacy]}" Style="{StaticResource Text.Label}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_ExcludeComms]}" Style="{StaticResource Text.Body}" />
                            <Label Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_ExcludeCommsDesc]}" Style="{StaticResource Text.Caption}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" 
                                IsToggled="{Binding ExcludeCommunications}"
                                Style="{StaticResource Switch.Standard}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_HideAmounts]}" Style="{StaticResource Text.Body}" />
                            <Label Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_HideAmountsDesc]}" Style="{StaticResource Text.Caption}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" 
                                IsToggled="{Binding HideAmountsInLists}"
                                Style="{StaticResource Switch.Standard}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_NotificationReminders]}" Style="{StaticResource Text.Body}" />
                            <Label Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_NotificationRemindersDesc]}" Style="{StaticResource Text.Caption}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" 
                                IsToggled="{Binding NotificationRemindersEnabled}"
                                Style="{StaticResource Switch.Standard}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_AppOpenPromoReminders]}" Style="{StaticResource Text.Body}" />
                            <Label Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_AppOpenPromoRemindersDesc]}" Style="{StaticResource Text.Caption}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" 
                                IsToggled="{Binding AppOpenPromoRemindersEnabled}"
                                Style="{StaticResource Switch.Standard}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" IsVisible="{Binding AppOpenPromoRemindersEnabled}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_UsageAccessPermission]}" Style="{StaticResource Text.Body}" />
                            <Label Text="{Binding UsageAccessStatusText}" Style="{StaticResource Text.Caption}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_GrantUsageAccess]}"
                                Style="{StaticResource Button.Secondary}"
                                Command="{Binding RequestUsageAccessCommand}"
                                IsVisible="{Binding HasUsageAccess, Converter={StaticResource InverseBoolConverter}}"
                                HeightRequest="36"
                                Padding="12,0" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_AppLock]}" Style="{StaticResource Text.Body}" />
                            <Label Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_AppLockDesc]}" Style="{StaticResource Text.Caption}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" 
                                IsToggled="{Binding AppLockEnabled}"
                                Style="{StaticResource Switch.Standard}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_GlobalSizeCap]}" Style="{StaticResource Text.Body}" />
                            <Label Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_GlobalSizeCapDesc]}" Style="{StaticResource Text.Caption}" />
                        </VerticalStackLayout>
                        <Entry Grid.Column="1"
                               Text="{Binding GlobalSizeCapMb}"
                               Keyboard="Numeric"
                               WidthRequest="80"
                               Style="{StaticResource Entry.Standard}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Data Management -->
            <Border Grid.Row="4" Style="{StaticResource Card.Row}" Padding="16">
                <VerticalStackLayout Spacing="14">
                    <Label Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_DataManagement]}" Style="{StaticResource Text.Label}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_StoredNotifications]}" Style="{StaticResource Text.Body}" />
                            <Label Text="{Binding NotificationCount, StringFormat='{0} notifications'}" Style="{StaticResource Text.Caption}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding StorageSize}" Style="{StaticResource Text.Caption}" VerticalOptions="Center" />
                    </Grid>

                    <Button Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_ManageSources]}"
                            Style="{StaticResource Button.Secondary}"
                            Command="{Binding OpenSourcesCommand}"
                            HorizontalOptions="Fill" />

                    <Button Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_Rules]}"
                            Style="{StaticResource Button.Secondary}"
                            Command="{Binding OpenRulesCommand}"
                            HorizontalOptions="Fill" />

                    <Button Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_ExportBackup]}"
                            Style="{StaticResource Button.Secondary}"
                            Command="{Binding ExportBackupCommand}"
                            HorizontalOptions="Fill" />

                    <Button Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_RestoreBackup]}"
                            Style="{StaticResource Button.Secondary}"
                            Command="{Binding RestoreBackupCommand}"
                            HorizontalOptions="Fill" />

                    <Button Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_ExportData]}"
                            Style="{StaticResource Button.Secondary}"
                            Command="{Binding ExportDataCommand}"
                            HorizontalOptions="Fill" />

                    <Button Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_ClearAllData]}"
                            Style="{StaticResource Button.Secondary}"
                            Command="{Binding ClearDataCommand}"
                            TextColor="{StaticResource ErrorColor}"
                            BorderColor="{StaticResource ErrorColor}"
                            HorizontalOptions="Fill" />
                </VerticalStackLayout>
            </Border>

            <!-- Onboarding -->
            <Border Grid.Row="5" Style="{StaticResource Card.Row}" Padding="16">
                <VerticalStackLayout Spacing="14">
                    <Label Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_Onboarding]}" Style="{StaticResource Text.Label}" />
                    <Button Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_RerunOnboarding]}"
                            Style="{StaticResource Button.Secondary}"
                            Command="{Binding OpenOnboardingCommand}"
                            HorizontalOptions="Fill" />
                </VerticalStackLayout>
            </Border>

            <!-- About -->
            <Border Grid.Row="6" Style="{StaticResource Card.Row}" Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_About]}" Style="{StaticResource Text.Label}" />
                    
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <Label Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_Version]}" Style="{StaticResource Text.Body}" />
                        <Label Grid.Column="1" Text="{Binding AppVersion}" Style="{StaticResource Text.Caption}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <Label Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_Framework]}" Style="{StaticResource Text.Body}" />
                        <Label Grid.Column="1" Text=".NET MAUI / .NET 10" Style="{StaticResource Text.Caption}" />
                    </Grid>

                    <Label Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_AppDesc]}"
                           Style="{StaticResource Text.Caption}"
                           HorizontalOptions="Center" />

                    <Label Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Settings_BuiltWith]}"
                           Style="{StaticResource Text.Caption}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>