<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ForceDark must be off: MIUI auto-darkening inverts our palette (black screens).
         Kept as a pure attribute overlay on MAUI's theme so splash handoff still works. -->
    <style name="AppTheme" parent="Maui.SplashTheme">
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
