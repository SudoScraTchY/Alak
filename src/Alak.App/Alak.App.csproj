<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android36.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NuGetAudit>false</NuGetAudit>
    <!-- Disable default Material3 theme to avoid missing color resources -->
    <AndroidUseMaterial3DefaultTheme>false</AndroidUseMaterial3DefaultTheme>

    <!-- Embed assemblies in APK (Fast Deployment staging is flaky on x86_64 emulators) -->
    <AndroidFastDeploymentType>None</AndroidFastDeploymentType>
    <!-- Let Android extract native libs at install -->
    <AndroidExtractNativeLibs>true</AndroidExtractNativeLibs>
    <!-- Self-contained runtime: no shared Mono runtime dependency (emulator lacks it) -->
    <AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>
    <!-- Embed managed assemblies INTO the APK (Debug default is false = fast deploy thin APK) -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <!-- Include x86_64 for the API 30 emulator alongside arm64 for physical devices -->
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>

    <!-- Display name -->
    <ApplicationTitle>Alak</ApplicationTitle>

    <!-- App Identifier -->
    <ApplicationId>com.alak.app</ApplicationId>
    <ApplicationIdGuid>5A1F4D2B-8E7C-4F3A-9B2D-6C8E1F4A7D3B</ApplicationIdGuid>

    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Android specific -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</TargetPlatformMinVersion>
    <AndroidTargetSdkVersion>36</AndroidTargetSdkVersion>
    <JavaMaximumHeapSize>2G</JavaMaximumHeapSize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <AndroidLinkMode>SdkOnly</AndroidLinkMode>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <AndroidStripLibraries>true</AndroidStripLibraries>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
  </PropertyGroup>

  <ItemGroup>
    <!-- App Icon -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#12252B" />

    <!-- Splash Screen -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#12252B" BaseSize="128,128" />

    <!-- Images -->
    <MauiImage Include="Resources\Images\*" />
    <MauiImage Update="Resources\Images\dotnet_bot.svg" BaseSize="168,208" />

    <!-- Fonts from design system §12.3 -->
    <MauiFont Include="Resources\Fonts\Vazirmatn-*.ttf" />
    <MauiFont Include="Resources\Fonts\JetBrainsMono-*.ttf" />

    <!-- Raw Assets (also copy to output) -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="CommunityToolkit.Maui" Version="15.0.1" />
    <PackageReference Include="LLamaSharp" Version="0.30.0" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" />
  </ItemGroup>

  <!-- Custom compiled generic ARM64-v8a llama.cpp runtimes (built with -march=armv8-a -moutline-atomics for Snapdragon 680 compatibility) -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'android-arm64' or ('$(RuntimeIdentifier)' == '' and $(RuntimeIdentifiers.Contains('android-arm64')))">
    <AndroidNativeLibrary Include="Platforms\Android\native\arm64-v8a\libllama.so" Link="lib\arm64-v8a\libllama.so" Abi="arm64-v8a" />
    <AndroidNativeLibrary Include="Platforms\Android\native\arm64-v8a\libggml.so" Link="lib\arm64-v8a\libggml.so" Abi="arm64-v8a" />
    <AndroidNativeLibrary Include="Platforms\Android\native\arm64-v8a\libggml-base.so" Link="lib\arm64-v8a\libggml-base.so" Abi="arm64-v8a" />
    <AndroidNativeLibrary Include="Platforms\Android\native\arm64-v8a\libggml-cpu.so" Link="lib\arm64-v8a\libggml-cpu.so" Abi="arm64-v8a" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'android-x64' or ('$(RuntimeIdentifier)' == '' and $(RuntimeIdentifiers.Contains('android-x64')))">
    <AndroidNativeLibrary Include="Platforms\Android\native\x86_64\libllama.so" Link="lib\x86_64\libllama.so" Abi="x86_64" />
    <AndroidNativeLibrary Include="Platforms\Android\native\x86_64\libggml.so" Link="lib\x86_64\libggml.so" Abi="x86_64" />
    <AndroidNativeLibrary Include="Platforms\Android\native\x86_64\libggml-base.so" Link="lib\x86_64\libggml-base.so" Abi="x86_64" />
    <AndroidNativeLibrary Include="Platforms\Android\native\x86_64\libggml-cpu.so" Link="lib\x86_64\libggml-cpu.so" Abi="x86_64" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Alak.Core\Alak.Core.csproj" />
    <ProjectReference Include="..\Alak.Text\Alak.Text.csproj" />
    <ProjectReference Include="..\Alak.Rules\Alak.Rules.csproj" />
    <ProjectReference Include="..\Alak.Storage\Alak.Storage.csproj" />
    <ProjectReference Include="..\Alak.Adaptive\Alak.Adaptive.csproj" />
    <ProjectReference Include="..\Alak.Inference.Abstractions\Alak.Inference.Abstractions.csproj" />
  </ItemGroup>

</Project>
