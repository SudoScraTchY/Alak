<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android36.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NuGetAudit>false</NuGetAudit>

    <!-- Display name -->
    <ApplicationTitle>Alak</ApplicationTitle>

    <!-- App Identifier -->
    <ApplicationId>com.alak.app</ApplicationId>
    <ApplicationIdGuid>5A1F4D2B-8E7C-4F3A-9B2D-6C8E1F4A7D3B</ApplicationIdGuid>

    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Android specific -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</TargetPlatformMinVersion>
    <AndroidTargetSdkVersion>36</AndroidTargetSdkVersion>

    <!-- Required for Android 13+ restricted settings handling -->
    <AndroidManifestPlaceholders>
      <notificationListenerServicePermission>android.permission.BIND_NOTIFICATION_LISTENER_SERVICE</notificationListenerServicePermission>
    </AndroidManifestPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <!-- App Icon -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#12252B" />

    <!-- Splash Screen -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#F3F5F6" BaseSize="128,128" />

    <!-- Images -->
    <MauiImage Include="Resources\Images\*" />
    <MauiImage Update="Resources\Images\dotnet_bot.svg" BaseSize="168,208" />

    <!-- Fonts from design system §12.3 -->
    <MauiFont Include="Resources\Fonts\Vazirmatn-*.ttf" />
    <MauiFont Include="Resources\Fonts\JetBrainsMono-*.ttf" />

    <!-- Raw Assets (also copy to output) -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="CommunityToolkit.Maui" Version="9.0.0" />
    <PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="3.116.1" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.0-rc.1.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Alak.Core\Alak.Core.csproj" />
    <ProjectReference Include="..\Alak.Text\Alak.Text.csproj" />
    <ProjectReference Include="..\Alak.Rules\Alak.Rules.csproj" />
    <ProjectReference Include="..\Alak.Storage\Alak.Storage.csproj" />
    <ProjectReference Include="..\Alak.Adaptive\Alak.Adaptive.csproj" />
    <ProjectReference Include="..\Alak.Inference.Abstractions\Alak.Inference.Abstractions.csproj" />
  </ItemGroup>

</Project>