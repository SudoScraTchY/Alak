root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{cs,csproj,xml,props}]
indent_style = space
indent_size = 4

[*.{json,yaml,yml}]
indent_style = space
indent_size = 2

[*.cs]
# Style: explicit, boring, readable (R6). Analyzers enforce the rest.
csharp_style_var_when_type_is_apparent = true:suggestion
dotnet_sort_system_directives_first = false
