<Project>
  <!--
    Alak — repo-wide build settings (ARC-004: nullable + warnings-as-errors).
    NOTE: children/contributors must NOT add package versions to this file;
    package versions live in each .csproj to avoid contention (see ADR-0001).
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>false</InvariantGlobalization>
    <NuGetAudit>false</NuGetAudit>
    <AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == '' and Exists('M:\Android\Sdks')">M:\Android\Sdks</AndroidSdkDirectory>
    <JavaSdkDirectory Condition="'$(JavaSdkDirectory)' == '' and Exists('C:\Program Files\Android\openjdk\jdk-21.0.8')">C:\Program Files\Android\openjdk\jdk-21.0.8</JavaSdkDirectory>
  </PropertyGroup>
</Project>
